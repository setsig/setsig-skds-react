{
  "name": "@setsig/react",
  "version": "1.0.0",
  "description": "Official setsig.com Proof-of-Physical-Presence React & Next.js SDK (RSC & React 19 Ready)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
