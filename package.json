  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0-0",
    "react-dom": ">=18.0.0 || >=19.0.0-0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.3"
  }
